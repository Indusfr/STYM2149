msgstr "Descendre la plage jouée d'une octave (touche Z)"

msgid "Move the played range one octave up (key X)"
msgstr "Monter la plage jouée d'une octave (touche X)"

msgid "Move the virtual keyboard one octave down (key Z)"
msgstr "Descendre le clavier virtuel d'une octave (touche Z)"

msgid "Move the virtual keyboard one octave up (key X)"
msgstr "Monter le clavier virtuel d'une octave (touche X)"

msgid "Move: drag notes or a selection without resizing them"
msgstr "Déplacer : glisser des notes ou une sélection sans les redimensionner"

msgid "N: the envelope plays the note x N / D"
msgstr "N : l'enveloppe joue la note x N / D"

msgid "NP step {1}: noise period {2}. Drag to draw, right click for a slider."
msgstr "NP, pas {1} : période de bruit {2}. Glisser pour dessiner, clic droit pour un curseur."

