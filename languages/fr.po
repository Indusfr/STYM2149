msgstr "PER, pas {1} : période de son {2} (plus aigu). Glisser pour dessiner, molette pour régler (Shift : 10), clic droit pour un curseur."

msgid "PER step {1}: {2} tone period (lower). Drag to draw, wheel to adjust (Shift: 10), right click for a slider."
msgstr "PER, pas {1} : période de son {2} (plus grave). Glisser pour dessiner, molette pour régler (Shift : 10), clic droit pour un curseur."

msgid "Pan"
msgstr "Panoramique"

msgid "Pan: 16 channels only; the 3-channel modes are mono"
msgstr "Pan : 16 voies seulement ; les modes 3 voies sont mono"

msgid "Panic"
msgstr "Panique"

msgid "Paste at the cursor (Ctrl+V)"
msgstr "Coller au curseur (Ctrl+V)"

msgid "Patches: Save current stores the focused channel sound"
msgstr "Patches : Save current enregistre le son du canal courant"

