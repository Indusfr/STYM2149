msgstr "Color del ruido: bajo es apagado, alto es nítido"

msgid "Noise period: a DMA track plays a sample, without noise"
msgstr "Período de ruido: una pista DMA reproduce una muestra, sin ruido"

msgid "Noise period: a Sync Buzzer plays the hardware envelope alone, without noise"
msgstr "Período de ruido: el Sync Buzzer reproduce solo la envolvente de hardware, sin ruido"

msgid "Noise period: low is bright, high is rumbling"
msgstr "Periodo de ruido: bajo es brillante, alto es retumbante"

msgid "Noise period: no noise in this channel's source"
msgstr "Periodo del ruido: no hay ruido en la fuente de este canal"

msgid "Noise period: no noise in this track's source"
msgstr "Período de ruido: no hay ruido en la fuente de esta pista"

msgid "Not used by percussion tracks"
msgstr "Las pistas de percusión no lo usan"

msgid "Note length as a share of the step"
msgstr "Duración de la nota como fracción del paso"

msgid "Notes are forced into the scale"
msgstr "Las notas se fuerzan a la escala"

msgid "Nothing selected in the sequencer"
msgstr "No hay nada seleccionado en el secuenciador"

msgid "Number of hits, spread as evenly as possible"
msgstr "Número de golpes, repartidos lo más uniformemente posible"

msgid "Number of repeats of each note"
msgstr "Número de repeticiones de cada nota"

msgid "Number of steps in the arpeggio table"
msgstr "Número de pasos de la tabla de arpegio"

msgid "Number of steps in the modulation table"
msgstr "Número de pasos de la tabla de modulación"

msgid "OCT: shift this step by one or more octaves"
msgstr "OCT: desplaza este paso una o más octavas"

msgid "OUT step {1}, {2} played: period {3}, {4} Hz"
msgstr "OUT, paso {1}, suena {2}: periodo {3}, {4} Hz"

msgid "OUT step {1}, {2} played: period {3}, {4} Hz (after the table end)"
msgstr "OUT, paso {1}, suena {2}: periodo {3}, {4} Hz (tras el final de la tabla)"

msgid "Octaves shown on the virtual keyboard"
msgstr "Octavas mostradas en el teclado virtual"

msgid "Off: placing a note writes that note only. Pick a chord to add voices above it."
msgstr "Off: al colocar una nota se escribe solo esa nota. Elige un acorde para añadir voces encima."

msgid "One gate for all tracks: the Gate slider then sets it"
msgstr "Un mismo gate para todas las pistas: lo fija el deslizador Gate"

msgid "One octave: the arpeggio stays within the chord as written"
msgstr "Una octava: el arpegio se queda dentro del acorde tal como está escrito"

msgid "Only loop entries jump back"
msgstr "Solo las entradas de bucle saltan atrás"

msgid "Only rest and note-off entries have a length"
msgstr "Solo las entradas de silencio y note-off tienen duración"

msgid "Open the Song window and chain patterns"
msgstr "Abre la ventana Song y encadena patrones"

msgid "Open the computer keyboard: play with the keys or click them. Typing only plays while this window is open."
msgstr "Abre el teclado del equipo: toca con las teclas o haz clic en ellas. Teclear solo toca mientras esta ventana está abierta."

